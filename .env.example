# LLM provider credential (set at least one)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Initial Administrator account. These bootstrap accounts.json only when it
# does not exist; later account management happens in the Administrator UI.
ADMIN_USERNAME=dk
ADMIN_PASSWORD=replace-with-a-long-random-password

# Signs Employee login cookies. Use a random value of at least 32 bytes.
SESSION_SECRET=replace-with-an-independent-random-secret

# APP_USERNAME / APP_PASSWORD remain accepted as legacy bootstrap aliases.

# Optional outside Railway. Railway supplies PORT automatically.
# PORT=3000
# HOST=0.0.0.0

# Optional persistent storage location. Mount a Railway volume here.
DATA_DIR=/data

# Optional: prevent startup from attempting a git pull outside Railway.
NO_GIT_SYNC=1
